# Copy this file to .env (same folder as docker-compose.yml) and fill in your own values.
# .env is ignored by git: never commit it.

# MySQL in Docker. DB_USERNAME must not be "root".
DB_USERNAME=railway
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Long random text, 32+ characters (PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 })) )
JWT_SECRET=change-me-to-a-long-random-value

# Gmail address and its App Password (for OTP and ticket emails)
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-letter-app-password

# Where the web app's folder is, relative to this folder (it has its own Dockerfile)
FRONTEND_DIR=../Railway_Frontend

# The web app opens on http://localhost:WEB_PORT
WEB_PORT=8081

# Optional switches
PAYMENTS_REQUIRED=true
RATE_LIMIT=true
DOCS_PUBLIC=false
